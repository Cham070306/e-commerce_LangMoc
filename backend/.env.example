# Backend Làng Mộc - cấu hình môi trường.
# Copy file này thành .env rồi chỉnh theo máy cá nhân. KHÔNG commit .env.
DATABASE_URL=postgresql://langmoc_user:replace-me@localhost:5432/langmoc_dev
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
# Thời hạn session cookie (giây). Mặc định 7 ngày.
SESSION_TTL_SECONDS=604800
# true khi chạy sau HTTPS; đặt false khi dev http localhost.
COOKIE_SECURE=false
