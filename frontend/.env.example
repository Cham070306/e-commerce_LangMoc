# mock: GET endpoints served by Vite during dev and npm run preview.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
# Keep disabled by default; set true to test the mock-only T5 guest checkout.
VITE_GUEST_CHECKOUT=false
# For real backend: change mode to live and restart Vite.
API_PROXY_TARGET=http://127.0.0.1:3000
