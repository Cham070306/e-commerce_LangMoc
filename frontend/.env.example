# mock: GET endpoints served by Vite during dev and npm run preview.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
# Guest checkout COD is supported in mock and live.
VITE_GUEST_CHECKOUT=true
# For real backend: change mode to live and restart Vite.
API_PROXY_TARGET=http://127.0.0.1:4000
# Địa chỉ/Maps mặc định đã được nhóm xác nhận; có thể ghi đè khi triển khai.
VITE_CONTACT_ADDRESS=
VITE_MAPS_QUERY=
VITE_MAPS_LABEL=
VITE_CONTACT_HOTLINE=0987223434
VITE_CONTACT_EMAIL=langmoc.support@gmail.com
VITE_CONTACT_HOURS=
